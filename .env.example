# ==============================================================================
# RepoBrain Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env or real API credentials to version control.
# ==============================================================================

# GitHub Personal Access Token (Optional, for higher rate limits during online ingestion)
GITHUB_TOKEN=your_github_token_here

# OpenRouter LLM API Configuration (Optional, for generative model enrichment)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# FalkorDB Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=repo_kg
